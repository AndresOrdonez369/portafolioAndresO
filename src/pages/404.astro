---
import Base from '../layouts/Base.astro';
---
<Base lang="en" route="/" title="Open circuit — Andrés Ordóñez-Bolaños" description="This trace leads nowhere.">
  <section class="nf">
    <svg class="nf__trace" viewBox="0 0 600 120" aria-hidden="true">
      <path d="M0 60 H230 L250 40 H290" />
      <path d="M330 80 H350 L370 60 H600" />
      <circle cx="290" cy="40" r="6" />
      <circle cx="330" cy="80" r="6" />
    </svg>
    <h1>Open circuit</h1>
    <p>This trace leads nowhere. The signal is back on the board. <span lang="es">Esta pista no lleva a ningún lado.</span></p>
    <div class="nf__cta">
      <a class="btn btn--primary" href="/">Back to the board</a>
      <a class="btn" href="/es/">Volver a la placa</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    padding: calc(var(--header) + 2rem) var(--gutter) 4rem;
    max-width: 60rem;
  }
  .nf__trace {
    width: min(100%, 36rem);
    margin-bottom: 2rem;
  }
  .nf__trace path {
    fill: none;
    stroke: var(--phosphor);
    stroke-width: 3;
  }
  .nf__trace circle {
    fill: var(--gold);
  }
  h1 {
    font-size: clamp(3.5rem, 2rem + 6vw, 6rem);
    color: var(--phosphor);
  }
  p {
    margin-top: 1.25rem;
    color: var(--mute);
    max-width: 36rem;
  }
  .nf__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
