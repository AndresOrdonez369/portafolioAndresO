---
import Base from '../../../layouts/Base.astro';
import Case from '../../../components/Case.astro';
import { projects } from '../../../data/projects';
import type { Project } from '../../../data/types';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
---
<Base lang="es" route={`/work/${p.slug}/`} title={`${p.title} — Andrés Ordóñez-Bolaños`} description={p.summary.es} image={p.cover}>
  <Case lang="es" p={p} />
</Base>
