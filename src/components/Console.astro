---
import type { Lang } from '../data/types';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const intro =
  lang === 'en'
    ? 'Andrés OS — type help. Esc closes.'
    : 'Andrés OS — escribe help. Esc cierra.';
---
<dialog class="console" id="console" aria-label="Console" data-lang={lang}>
  <div class="console__log" id="console-log" role="log" aria-live="polite">
    <p>{intro}</p>
  </div>
  <form class="console__line" id="console-form" autocomplete="off">
    <label for="console-input" class="mono">~/andres $</label>
    <input id="console-input" name="cmd" spellcheck="false" autocapitalize="off" />
  </form>
</dialog>

<style>
  .console {
    position: fixed;
    inset: auto var(--gutter) var(--gutter) auto;
    width: min(36rem, calc(100vw - 2 * var(--gutter)));
    max-height: min(26rem, 70vh);
    margin: 0;
    padding: 0;
    display: none;
    flex-direction: column;
    background: color-mix(in srgb, var(--night) 94%, transparent);
    border: 1px solid var(--phosphor-dim);
    color: var(--phosphor);
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.8);
  }
  .console[open] {
    display: flex;
  }
  .console::backdrop {
    background: transparent;
  }
  .console__log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.1rem 0.5rem;
    line-height: 1.7;
  }
  .console__log :global(p) {
    white-space: pre-wrap;
  }
  .console__log :global(.cmd) {
    color: var(--silk);
  }
  .console__log :global(.err) {
    color: var(--magenta);
  }
  .console__line {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1.1rem 1rem;
    border-top: 1px solid var(--trace);
  }
  .console__line label {
    color: var(--mute);
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  .console__line input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--silk);
    font: inherit;
    outline: none;
  }
  .console__line:focus-within {
    box-shadow: inset 0 2px 0 var(--phosphor);
  }
</style>
