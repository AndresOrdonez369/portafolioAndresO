---
import ProjectTile from './ProjectTile.astro';
import { projects } from '../data/projects';
import type { Lang, Project } from '../data/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const T = (en: string, es: string) => (lang === 'en' ? en : es);

// Facets are derived from the data, so a new project files itself.
const has = (p: Project, re: RegExp) => [...p.stack, ...p.platforms].some((s) => re.test(s));
const facets = (p: Project) =>
  [
    p.group === 'industry' && 'games',
    has(p, /^(VR|AR)$|Meta Quest|XR/i) && 'xr',
    has(p, /UEFN|Verse/i) && 'uefn',
    has(p, /Unreal/i) && 'unreal',
    has(p, /Unity/i) && 'unity',
    (p.status === 'research' || has(p, /Installation|3D printing/i)) && 'research',
    p.group === 'web' && 'web',
  ].filter(Boolean) as string[];

const defs = [
  { id: 'all', label: T('All', 'Todos') },
  { id: 'games', label: T('Shipped games', 'Juegos lanzados') },
  { id: 'xr', label: 'VR · AR' },
  { id: 'uefn', label: 'UEFN · Verse' },
  { id: 'unreal', label: 'Unreal' },
  { id: 'unity', label: 'Unity' },
  { id: 'research', label: T('Research · Art', 'Investigación · Arte') },
  { id: 'web', label: T('Web · Mobile', 'Web · Móvil') },
];
const withFacets = projects.map((p) => ({ p, f: facets(p) }));
const filters = defs.map((d) => ({ ...d, count: d.id === 'all' ? projects.length : withFacets.filter((x) => x.f.includes(d.id)).length }));
---
<div class="gallery" data-gallery>
  <div class="filters" role="group" aria-label={T('Filter projects', 'Filtrar proyectos')}>
    {filters.map((f) => (
      <button type="button" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>
        {f.label}<span class="filters__n">{f.count}</span>
      </button>
    ))}
  </div>
  <div class="bento">
    {withFacets.map(({ p, f }, i) => <ProjectTile lang={lang} p={p} size={p.featured ? 'lead' : 'std'} facets={f.join(' ')} index={i} />)}
  </div>
</div>

<style>
  .gallery {
    max-width: 84rem;
  }
  /* Filters: layer toggles, like the layer panel of a board editor */
  .filters {
    position: sticky;
    top: calc(var(--header) + 0.5rem);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    padding: 0.5rem;
    background: color-mix(in srgb, var(--night) 92%, transparent);
    border: 1px solid var(--trace);
    width: fit-content;
    max-width: 100%;
  }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.8rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--mute);
    border: 1px solid transparent;
    transition: color 0.2s var(--ease), background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .filters button:hover {
    color: var(--silk);
    border-color: var(--trace);
  }
  .filters button[aria-pressed='true'] {
    color: var(--night);
    background: var(--phosphor);
  }
  .filters__n {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    opacity: 0.75;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .bento > :global(.tile) {
    grid-column: span 2;
  }
  .bento > :global(.tile--lead) {
    grid-column: 1 / -1;
  }
  .bento > :global(.tile[hidden]) {
    display: none;
  }
  @media (max-width: 1100px) {
    .bento > :global(.tile) {
      grid-column: span 3;
    }
    .bento > :global(.tile--lead) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .bento > :global(.tile),
    .bento > :global(.tile--lead) {
      grid-column: 1 / -1;
    }
    .filters {
      position: static;
      flex-wrap: nowrap;
      overflow-x: auto;
      width: 100%;
    }
    .filters button {
      white-space: nowrap;
    }
  }
</style>
