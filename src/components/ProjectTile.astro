---
import Icon from './Icon.astro';
import { statusLabel, path } from '../data/site';
import { sm } from '../data/img';
import type { Lang, Project } from '../data/types';

interface Props {
  lang: Lang;
  p: Project;
  size?: 'lead' | 'std';
  facets?: string;
  index?: number;
}
const { lang, p, size = 'std', facets = '', index = 0 } = Astro.props;
const L = (v: { en: string; es: string }) => v[lang];
const href = path(lang, `/work/${p.slug}/`);
const minutes = p.metrics?.find((m) => m.label.en === 'minutes played');
const video = p.videos?.[0];
const shots = (p.gallery?.length ?? 0) + (p.cover ? 1 : 0);
const tint = p.group === 'industry' ? 'var(--magenta)' : p.group === 'web' ? 'var(--violet)' : 'var(--blue)';
const kind = p.group === 'industry' ? (lang === 'en' ? 'Shipped game' : 'Juego lanzado') : p.platforms[0];
---
<article
  class:list={['tile', `tile--${size}`, { 'tile--portrait': p.portrait }]}
  style={`--tint:${tint};view-transition-name:tile-${p.slug}`}
  data-facets={facets}
>
  <div class="tile__media">
    {p.cover ? (
      <img src={size === 'lead' ? p.cover : sm(p.cover)} alt="" loading="lazy" decoding="async" style={`view-transition-name:art-${p.slug}`} />
    ) : (
      <div class="tile__poster" aria-hidden="true"><span>{p.title}</span></div>
    )}
    <span class="tile__scan" aria-hidden="true"></span>
    {video && (
      <button type="button" class="tile__play" data-video={video.id} aria-label={`${lang === 'en' ? 'Play video' : 'Reproducir video'}: ${p.title}`}>
        <Icon name="play" />
      </button>
    )}
  </div>
  <div class="tile__body">
    <p class="tile__kicker">
      <span class="mono">{String(index + 1).padStart(2, '0')}</span>
      <span>{kind}</span>
      {p.status === 'live' && <span class="tile__live">{statusLabel('live', lang)}</span>}
    </p>
    <h3 class="tile__title"><a href={href}>{p.title}</a></h3>
    <p class="tile__meta">{L(p.role)} · {p.year}</p>
    {size === 'lead' && <p class="tile__sum">{L(p.summary)}</p>}
    <div class="tile__foot">
      {minutes ? (
        <span class="tile__metric"><b>{minutes.value}</b>{L(minutes.label)}</span>
      ) : (
        <ul class="tile__tags">{p.stack.slice(0, 3).map((s) => <li>{s}</li>)}</ul>
      )}
      <span class="tile__open" aria-hidden="true">
        {shots > 1 && <span>{shots} {lang === 'en' ? 'images' : 'imágenes'}</span>}
        <Icon name="arrow" />
      </span>
    </div>
  </div>
</article>

<style>
  .tile {
    --cut: 1.1rem;
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--board);
    /* one chamfered corner, like a chip's orientation mark */
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
    transition: transform 0.45s var(--ease), background 0.3s var(--ease);
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border: 1px solid var(--trace);
    border-bottom: 3px solid var(--tint);
    transition: border-color 0.3s var(--ease);
  }
  .tile:hover,
  .tile:focus-within {
    transform: translateY(-5px);
    background: var(--board-2);
  }
  .tile:hover::before,
  .tile:focus-within::before {
    border-color: var(--tint);
  }
  .tile__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--night);
  }
  .tile--portrait .tile__media img {
    object-fit: contain;
    background: radial-gradient(circle at 50% 40%, #1b2a4a, var(--night) 70%);
  }
  .tile__media img,
  .tile__media :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .tile__media img {
    transition: transform 1s var(--ease), filter 0.6s var(--ease);
    filter: saturate(0.9) contrast(1.02);
  }
  .tile:hover .tile__media img {
    transform: scale(1.06);
    filter: saturate(1.18);
  }
  .tile__scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--phosphor) 55%, transparent) 50%, transparent 100%) 0 -30% / 100% 18% no-repeat;
    mix-blend-mode: screen;
    opacity: 0;
  }
  .tile:hover .tile__scan {
    opacity: 1;
    background-position: 0 130%;
    transition: background-position 0.9s var(--ease), opacity 0.2s;
  }
  .tile__poster {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1.25rem;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--tint) 35%, transparent) 1px, transparent 1.5px) 0 0 / 18px 18px,
      linear-gradient(150deg, color-mix(in srgb, var(--tint) 24%, var(--night)), var(--night) 70%);
  }
  .tile__poster span {
    font-family: var(--f-display);
    font-weight: 900;
    font-size: clamp(1.8rem, 1.2rem + 1.5vw, 2.6rem);
    line-height: 0.92;
    text-transform: uppercase;
  }
  .tile__play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    width: 3.75rem;
    height: 3.75rem;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--night);
    background: var(--phosphor);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--phosphor) 25%, transparent);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .tile__play :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
    fill: currentColor;
    margin-left: 0.15rem;
  }
  .tile__play:hover {
    transform: scale(1.08);
    box-shadow: 0 0 0 12px color-mix(in srgb, var(--phosphor) 30%, transparent);
  }
  .tile__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    padding: 1rem 1.2rem 1.15rem;
  }
  .tile__kicker {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.8125rem;
    color: var(--mute);
    order: 2;
  }
  .tile__kicker .mono {
    color: var(--tint);
    filter: brightness(1.25);
  }
  .tile__live {
    margin-left: auto;
    font-weight: 600;
    color: var(--phosphor);
  }
  .tile__live::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: var(--phosphor);
    box-shadow: 0 0 8px var(--phosphor);
    vertical-align: 0.08em;
  }
  .tile__title {
    order: 1;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 1.25rem + 0.7vw, 2rem);
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .tile__title a {
    text-decoration: none;
  }
  .tile__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .tile__meta {
    order: 3;
    font-size: 0.9375rem;
    color: var(--silk);
  }
  .tile__sum {
    order: 4;
    margin-top: 0.4rem;
    color: var(--mute);
    max-width: 38rem;
  }
  .tile__foot {
    order: 5;
    margin-top: auto;
    padding-top: 0.8rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .tile__metric {
    display: grid;
    font-size: 0.875rem;
    color: var(--mute);
  }
  .tile__metric b {
    font-family: var(--f-display);
    font-weight: 900;
    font-size: clamp(1.9rem, 1.5rem + 1vw, 2.6rem);
    line-height: 0.9;
    color: var(--silk);
  }
  .tile__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tile__tags li {
    padding: 0.15rem 0.5rem;
    font-size: 0.8125rem;
    color: var(--mute);
    border: 1px solid var(--trace);
  }
  .tile__open {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8125rem;
    color: var(--mute);
    white-space: nowrap;
  }
  .tile__open :global(svg) {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.55rem;
    color: var(--silk);
    border: 1px solid var(--trace);
    transition: background 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .tile:hover .tile__open :global(svg),
  .tile:focus-within .tile__open :global(svg) {
    color: var(--night);
    background: var(--phosphor);
    border-color: var(--phosphor);
  }

  /* Lead tiles: a full-width feature, art beside the story */
  @media (min-width: 900px) {
    .tile--lead {
      flex-direction: row;
      min-height: 24rem;
    }
    .tile--lead .tile__media {
      flex: 1.5;
      aspect-ratio: auto;
    }
    .tile--lead .tile__body {
      flex: 1;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      justify-content: center;
      gap: 0.6rem;
    }
    .tile--lead:nth-of-type(even) {
      flex-direction: row-reverse;
    }
    .tile--lead .tile__title {
      font-size: clamp(2.4rem, 1.6rem + 2.4vw, 4rem);
      line-height: 0.92;
    }
    .tile--lead .tile__foot {
      margin-top: 1rem;
    }
    .tile--lead .tile__metric b {
      font-size: clamp(3rem, 2rem + 2.5vw, 4.5rem);
      color: var(--phosphor);
    }
  }
</style>
